// use prisma-8

enum UserRole {
  MEMBER
  ADMIN
}

model User {
  id           Uuid      @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(MEMBER)
  createdAt    DateTime  @default(now())
}

model Session {
  id        Uuid     @id @default(uuid())
  startTime DateTime
  capacity  Int      @default(20)
  createdAt DateTime @default(now())
}